@@ -4,6 +4,8 @@ package seccomp
 
 import (
 	"errors"
+	"fmt"
+	"os"
 
 	"github.com/opencontainers/runc/libcontainer/configs"
 	"github.com/opencontainers/runtime-spec/specs-go"
@@ -11,9 +13,15 @@ import (
 
 var ErrSeccompNotEnabled = errors.New("seccomp: config provided but seccomp not supported")
 
+const outpostNoSeccompOptIn = "OUTPOST_DKS_ALLOW_NO_SECCOMP"
+
 // InitSeccomp does nothing because seccomp is not supported.
 func InitSeccomp(config *configs.Seccomp) (int, error) {
 	if config != nil {
+		if os.Getenv(outpostNoSeccompOptIn) == "1" {
+			fmt.Fprintln(os.Stderr, "WARNING: Outpost DKS is ignoring OCI seccomp rules; this runtime does not enforce seccomp")
+			return -1, nil
+		}
 		return -1, ErrSeccompNotEnabled
 	}
 	return -1, nil
diff --git a/libcontainer/seccomp/seccomp_unsupported_outpost_test.go b/libcontainer/seccomp/seccomp_unsupported_outpost_test.go
new file mode 100644
index 0000000..17adba8
--- /dev/null
+++ b/libcontainer/seccomp/seccomp_unsupported_outpost_test.go
@@ -0,0 +1,40 @@
+//go:build !linux || !cgo || !seccomp
+
+package seccomp
+
+import (
+	"errors"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/opencontainers/runc/libcontainer/configs"
+)
+
+func TestOutpostNoSeccompRequiresExplicitOptIn(t *testing.T) {
+	config := &configs.Seccomp{}
+	t.Setenv(outpostNoSeccompOptIn, "")
+	if _, err := InitSeccomp(config); !errors.Is(err, ErrSeccompNotEnabled) {
+		t.Fatalf("default must fail closed: %v", err)
+	}
+	t.Setenv(outpostNoSeccompOptIn, "true")
+	if _, err := InitSeccomp(config); !errors.Is(err, ErrSeccompNotEnabled) {
+		t.Fatalf("non-exact opt-in must fail closed: %v", err)
+	}
+	t.Setenv(outpostNoSeccompOptIn, "1")
+	read, write, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	saved := os.Stderr
+	os.Stderr = write
+	_, gotErr := InitSeccomp(config)
+	write.Close()
+	os.Stderr = saved
+	message := make([]byte, 256)
+	n, _ := read.Read(message)
+	read.Close()
+	if gotErr != nil || !strings.Contains(string(message[:n]), "WARNING: Outpost DKS is ignoring OCI seccomp rules") {
+		t.Fatalf("opt-in must warn and continue: err=%v warning=%q", gotErr, message[:n])
+	}
+}
