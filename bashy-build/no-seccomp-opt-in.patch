index 0000000..73bea88
--- /dev/null
+++ b/libcontainer/seccomp/seccomp_unsupported_default_test.go
@@ -0,0 +1,16 @@
+//go:build (!linux || !cgo || !seccomp) && !dks_noseccomp
+
+package seccomp
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/opencontainers/runc/libcontainer/configs"
+)
+
+func TestDefaultNoSeccompFailsClosed(t *testing.T) {
+	if _, err := InitSeccomp(&configs.Seccomp{}); !errors.Is(err, ErrSeccompNotEnabled) {
+		t.Fatalf("default no-seccomp build must fail closed: %v", err)
+	}
+}
diff --git a/libcontainer/seccomp/seccomp_unsupported_dks.go b/libcontainer/seccomp/seccomp_unsupported_dks.go
new file mode 100644
index 0000000..4d1ca9a
--- /dev/null
+++ b/libcontainer/seccomp/seccomp_unsupported_dks.go
@@ -0,0 +1,15 @@
+//go:build (!linux || !cgo || !seccomp) && dks_noseccomp
+
+package seccomp
+
+import (
+	"fmt"
+	"os"
+
+	"github.com/opencontainers/runc/libcontainer/configs"
+)
+
+func initUnsupportedSeccomp(_ *configs.Seccomp) (int, error) {
+	fmt.Fprintln(os.Stderr, "WARNING: Outpost DKS is ignoring OCI seccomp rules; this runtime does not enforce seccomp")
+	return -1, nil
+}
diff --git a/libcontainer/seccomp/seccomp_unsupported_dks_test.go b/libcontainer/seccomp/seccomp_unsupported_dks_test.go
new file mode 100644
index 0000000..45f0a04
--- /dev/null
+++ b/libcontainer/seccomp/seccomp_unsupported_dks_test.go
@@ -0,0 +1,29 @@
+//go:build (!linux || !cgo || !seccomp) && dks_noseccomp
+
+package seccomp
+
+import (
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/opencontainers/runc/libcontainer/configs"
+)
+
+func TestDKSNoSeccompVariantWarns(t *testing.T) {
+	read, write, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	saved := os.Stderr
+	os.Stderr = write
+	fd, gotErr := InitSeccomp(&configs.Seccomp{})
+	write.Close()
+	os.Stderr = saved
+	buf := make([]byte, 256)
+	n, _ := read.Read(buf)
+	read.Close()
+	if fd != -1 || gotErr != nil || !strings.Contains(string(buf[:n]), "WARNING: Outpost DKS is ignoring OCI seccomp rules") {
+		t.Fatalf("DKS variant fd=%d err=%v warning=%q", fd, gotErr, buf[:n])
+	}
+}
